NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

MONGODB_URI=mongodb://127.0.0.1:27017/textile_job_portal

# Redis (URL OR host/port/user/pass)
# REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
MPIN_SESSION_EXPIRES_IN=12h

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GOOGLE_MAPS_API_KEY=

# Gmail SMTP (App Password)
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

ADMIN_EMAIL=admin@textilejobs.local
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=Platform Admin

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
